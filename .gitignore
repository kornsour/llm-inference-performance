# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
dist/
build/

# Torch / build extensions
*.so
kernels/build/
~/.cache/torch_extensions/

# Generated benchmark artifacts — keep the canonical latest.json / tp_latest.json as committed evidence
benchmarks/results/*.json
!benchmarks/results/latest.json
!benchmarks/results/tp_latest.json

# benchmarks/results/history.duckdb *is* committed (it's the whole point — see
# llminf.history) — only an uncheckpointed write-ahead log is transient here.
*.duckdb.wal

# OS / editor
.DS_Store
.idea/
*.log
